<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:entities="clr-namespace:Signals.CoreLayer.Entities"
             xmlns:lang="clr-namespace:Signals.Resources"
			 xmlns:local="clr-namespace:Signals.Views"
             xmlns:vm="clr-namespace:Signals.ViewModels"
             x:Class="Signals.Views.HoldingsItemPageView"
             x:DataType="vm:HoldingsItemPageViewModel"
             xmlns:converters="clr-namespace:Signals.Converters">
    <!-- added xmlns:converters -->
    <Design.DataContext>
        <vm:HoldingsItemPageViewModel />
    </Design.DataContext>
    <UserControl.Resources>
        <converters:CurrencyOrEmptyConverter x:Key="DecimalOrEmptyConverter" />
        <converters:LocalTimeConverter x:Key="LocalTimeConverter" />
    </UserControl.Resources>

    <Grid>
        <ContentControl Content="{Binding HoldingItem}">
            <ContentControl.ContentTemplate>
                <DataTemplate DataType="entities:Holding">
                    <Grid RowDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Row="0">
                            <Button Classes="navigation" Background="Transparent"
                                    HorizontalAlignment="Left"
                                    Command="{Binding $parent[local:MainView].((vm:MainViewModel)DataContext).GoToHoldingsCommand, FallbackValue=null}">
                                <StackPanel>
									<!-- Back arrow -->
                                    <Label Classes="icon" FontSize="24" Content="&#xe058;"></Label>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" IsEnabled="True">
                            <StackPanel>
                                <!-- {x:Static lang:Resources.AboutParagraph1} 
                                Name
                                Exchange
                                QuoteReceived
                                -->
                                <TextBlock Text="{Binding  Symbol}" />
                                <Label Content="{x:Static lang:Resources.Name}" />
                                <TextBlock Text="{Binding  Name}" />
                                <Label Content="{x:Static lang:Resources.Exchange}" />
                                <TextBlock Text="{Binding  ExchangeName}" />
                                <Label Content=
                                       "{x:Static lang:Resources.QuoteReceived}" 
                                       />
                                <TextBlock Text="{Binding  WhenLatestQuoteReceived, 
                                    StringFormat={}{0:MMM d\, yyyy hh:mm tt}
                                    , Converter={StaticResource LocalTimeConverter}}" />

                                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto"
                                      ColumnDefinitions="*,5,*">
                                    <Grid.Styles>
                                        <Style Selector="TextBlock">
                                            <Setter Property="Margin" Value="0 0 8 0"></Setter>
                                        </Style>
                                        <Style Selector="TextBox">
                                            <Setter Property="Margin" Value="0 0 8 0"></Setter>
                                        </Style>
                                    </Grid.Styles>

                                    <!--Display data from quotation service-->
                                    <StackPanel Grid.Row="0" Grid.Column="0">
                                        <Label Content="{x:Static lang:Resources.LatestQuote}" />
                                        <TextBlock Text="{Binding  LatestQuotedPrice, StringFormat={}{0:C}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="0" Grid.Column="2">
                                        <Label Content="{x:Static lang:Resources.PercentChange}" />
                                        <TextBlock
                                            Text="{Binding  CurrentDayPercentChange, StringFormat={}{0:#0.0%}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="0">
                                        <Label Content="{x:Static lang:Resources.PreviousClose}" />
                                        <TextBlock Text="{Binding  PreviousDayClosingPrice, StringFormat={}{0:C}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="1" Grid.Column="2">
                                        <Label Content="{x:Static lang:Resources.TodayOpen}" />
                                        <TextBlock Text="{Binding  CurrentDayOpeningPrice, StringFormat={}{0:C}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <Label Content="{x:Static lang:Resources.DailyLow}" />
                                        <TextBlock Text="{Binding  CurrentDayLowPrice, StringFormat={}{0:C}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="2">
                                        <Label Content="{x:Static lang:Resources.DailyHigh}" />
                                        <TextBlock Text="{Binding  CurrentDayHighPrice, StringFormat={}{0:C}}" />
                                    </StackPanel>

                                    <!-- Fillable fields -->
                                    <StackPanel Grid.Row="3" Grid.Column="0">
                                        <Label Content="{x:Static lang:Resources.WhenPurchased}" />
                                        <TextBlock
                                            Text="{Binding  WhenLastPurchased, 
                                            StringFormat={}{0:MMM d\, yyyy hh:mm tt}
                                            , Converter={StaticResource LocalTimeConverter}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="2">
                                        <Label Content="{x:Static lang:Resources.NumberOfUnitsHeld}" />
                                        <TextBlock
                                            Text="{Binding  UnitsHeld, StringFormat={}{0:#0}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0">
                                        <Label Content="{x:Static lang:Resources.AveragePurchasePrice}" />
                                        <TextBlock Text="{Binding  AveragePurchasePrice, StringFormat={}{0:C}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="2">
                                        <Label Content="{x:Static lang:Resources.PeakPriceSincePurchase}" />
                                        <TextBlock Text="{Binding  PeakPriceSincePurchase, 
                                                 Converter={x:Static converters:CurrencyOrEmptyConverter.Instance}, 
                                                 UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:C}}" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel>
                                    <Label Content="{x:Static lang:Resources.UseTrailingStop}"></Label>
                                    <CheckBox IsChecked="{Binding UseTrailingStop}"></CheckBox>
                                    <Label Content="{x:Static lang:Resources.TrailingStop}"></Label>
                                    <Slider Value="{Binding TrailingStop}"></Slider>
                                </StackPanel>


                            </StackPanel>
                        </ScrollViewer>
                        <!-- Buy and Sell buttons ;-->
                        <StackPanel Classes="buttons" Grid.Row="2" Orientation="Horizontal">
                            <IconButton Classes="buy" IconText="&#xeb48;" Content="{x:Static lang:Resources.Buy}"
                                        Command="{Binding $parent[UserControl].((vm:HoldingsItemPageViewModel)DataContext).BuyCommand, FallbackValue=null}"
                                        CommandParameter="{Binding}">
                            </IconButton>
                            <IconButton Classes="sell" IconText="&#xe478;" Content="{x:Static lang:Resources.Sell}"
                                        Command="{Binding $parent[UserControl].((vm:HoldingsItemPageViewModel)DataContext).SellCommand, FallbackValue=null}"
                                        CommandParameter="{Binding}">
                            </IconButton>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>
    </Grid>
</UserControl>